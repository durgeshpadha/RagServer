@inject IConfiguration Configuration

<nav class="shell-nav" aria-label="Primary">
    <NavLink class="shell-link" href="" Match="NavLinkMatch.All">Assistant</NavLink>
    <a class="shell-link" href="@SwaggerUrl" target="_blank" rel="noopener noreferrer">Swagger</a>
    <a class="shell-link" href="@RedocUrl" target="_blank" rel="noopener noreferrer">ReDoc</a>
</nav>

@code {
    private string ApiBaseUrl
    {
        get
        {
            var url = Configuration["ApiBaseUrl"] ?? "http://localhost:5228/";
            return url.EndsWith("/", StringComparison.Ordinal) ? url : $"{url}/";
        }
    }

    private string SwaggerUrl => new Uri(new Uri(ApiBaseUrl), "swagger").ToString();
    private string RedocUrl => new Uri(new Uri(ApiBaseUrl), "redoc").ToString();
}
