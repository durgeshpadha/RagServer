@page "/"
@inject RagApiClient ApiClient
@inject MarkdownRenderer MarkdownRenderer
@implements IDisposable

<PageTitle>RAG Workbench</PageTitle>

<div class="workspace-grid">
    <section class="panel chat-panel">
        <div class="panel-head">
            <h2>Ask</h2>
            <p>Chat with your indexed knowledge base.</p>
        </div>

        <div class="chat-stream">
            @if (_messages.Count == 0)
            {
                <div class="empty-state">
                    <h3>Start a conversation</h3>
                    <p>Ask a question about your codebase or documents after ingestion.</p>
                </div>
            }

            @foreach (var message in _messages)
            {
                <article class="msg @(message.IsUser ? "msg-user" : "msg-ai")">
                    <div class="msg-role">@(message.IsUser ? "You" : "RAG")</div>
                    @if (message.IsUser)
                    {
                        <p class="msg-plain">@message.Text</p>
                    }
                    else
                    {
                        <div class="msg-markdown">@((MarkupString)MarkdownRenderer.ToHtml(message.Text))</div>
                    }
                    @if (!message.IsUser && message.IsStopped && !_isAsking)
                    {
                        <button type="button" class="regen-btn" @onclick="() => RegenerateAsync(message)">Regenerate</button>
                    }
                    @if (!message.IsUser && message.Citations.Count > 0)
                    {
                        <details class="citations">
                            <summary>Citations (@message.Citations.Count)</summary>
                            <ul>
                                @foreach (var cite in message.Citations)
                                {
                                    <li><code>@cite.Source</code> chunk <strong>@cite.ChunkIndex</strong></li>
                                }
                            </ul>
                        </details>
                    }
                </article>
            }

            @if (_isAsking)
            {
                <article class="msg msg-ai loader-msg">
                    <div class="msg-role">RAG</div>
                    <div class="typing">
                        <span></span><span></span><span></span>
                    </div>
                </article>
            }
        </div>

        <form class="chat-form" @onsubmit="HandleAskAsync">
            <div class="model-picker">
                <div class="model-row">
                    <label for="model-select">Model</label>
                    <button type="button" @onclick="StartNewChatAsync" disabled="@(_messages.Count == 0 && string.IsNullOrWhiteSpace(_query))">New Chat</button>
                </div>
                <select id="model-select" @bind="_selectedModel" disabled="@(_isAsking || _isModelsLoading || _availableModels.Count == 0)">
                    @if (_availableModels.Count == 0)
                    {
                        <option value="">No models available</option>
                    }
                    else
                    {
                        @foreach (var model in _availableModels)
                        {
                            <option value="@model">@model</option>
                        }
                    }
                </select>
            </div>
            <label class="kb-toggle">
                <input type="checkbox" @bind="_useKnowledgeBase" disabled="@_isAsking" />
                <span>Use Knowledge Base</span>
            </label>
            <textarea rows="2" placeholder="Ask anything about your indexed files..." @bind="_query" disabled="@_isAsking"></textarea>
            <div class="chat-actions">
                <button type="submit" disabled="@(_isAsking || _isModelsLoading || _availableModels.Count == 0 || string.IsNullOrWhiteSpace(_query))">@(_isAsking ? "Thinking..." : "Send")</button>
                @if (_isAsking)
                {
                    <button type="button" class="stop-btn" @onclick="StopGenerating">Stop generating</button>
                }
            </div>
        </form>
    </section>

    <section class="panel action-panel">
        <div class="panel-head">
            <h2>Data & Ingest</h2>
            <p>Control indexing and storage lifecycle.</p>
        </div>

        <div class="card-stack">
            <article class="action-card">
                <h3>Vector Store</h3>
                <p class="stat">@(_dataCount.HasValue ? _dataCount.Value.ToString() : "-")</p>
                <p class="helper">Stored chunks currently in RAG.</p>
                <div class="actions-row">
                    <button @onclick="RefreshCountAsync" disabled="@_isCountBusy">@(_isCountBusy ? "Loading..." : "Refresh Count")</button>
                    <button class="danger" @onclick="ClearDataAsync" disabled="@_isClearBusy">@(_isClearBusy ? "Clearing..." : "Clear Data")</button>
                </div>
            </article>

            <article class="action-card">
                <h3>Ingest Knowledge Base</h3>
                <p class="helper">Reads files, creates embeddings, and stores vectors.</p>
                <div class="chat-actions">
                    <button @onclick="RunIngestAsync" disabled="@_isIngesting">@(_isIngesting ? "Ingesting..." : "Run Ingest")</button>
                    @if (_isIngesting)
                    {
                        <button type="button" class="stop-btn" @onclick="StopIngest">Stop ingest</button>
                    }
                </div>
                @if (_isIngesting || _ingestProgressPercent > 0)
                {
                    <div class="ingest-progress">
                        <div class="ingest-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_ingestProgressPercent">
                            <div class="ingest-progress-fill" style="width: @_ingestProgressPercent%;"></div>
                        </div>
                        <p class="helper">@_ingestProgressPercent% | @_ingestCompletedFiles / @_ingestTotalFiles files | Remaining: @_ingestRemainingFiles</p>
                        @if (_isIngesting || _ingestFileTotalChunks > 0)
                        {
                            <div class="ingest-progress ingest-progress-secondary">
                                <div class="ingest-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_ingestFileProgressPercent">
                                    <div class="ingest-progress-fill" style="width: @_ingestFileProgressPercent%;"></div>
                                </div>
                                <p class="helper">Current file: @_ingestFileProgressPercent% | @_ingestFileCompletedChunks / @_ingestFileTotalChunks chunks | Stage: <span class="@GetIngestStageClass(_ingestFileStage)">@_ingestFileStage</span></p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_ingestCurrentFile))
                        {
                            <p class="helper ingest-current-file">Current: <code class="ingest-file-name">@_ingestCurrentFile</code></p>
                        }
                    </div>
                }

                @if (_lastIngest is not null)
                {
                    <dl class="ingest-summary">
                        <div><dt>Scanned</dt><dd>@_lastIngest.FilesScanned</dd></div>
                        <div><dt>Indexed</dt><dd>@_lastIngest.FilesIndexed</dd></div>
                        <div><dt>Chunks</dt><dd>@_lastIngest.ChunksAdded</dd></div>
                        <div><dt>Stored</dt><dd>@_lastIngest.TotalStored</dd></div>
                        <div><dt>Failures</dt><dd>@_lastIngest.Failures.Count</dd></div>
                        <div><dt>Duration</dt><dd>@_lastIngest.DurationMs ms</dd></div>
                    </dl>
                }

                @if (_ingestErrors.Count > 0)
                {
                    <div class="ingest-errors-head">
                        <h4>Ingest Errors (@_ingestErrors.Count)</h4>
                        <button type="button" class="danger" @onclick="ClearIngestErrors">Clear Errors</button>
                    </div>
                    <ul class="ingest-errors-list">
                        @foreach (var err in _ingestErrors)
                        {
                            <li>
                                <p><strong>@err.ErrorCode</strong>: @err.Message</p>
                                <p><code class="ingest-file-name">@err.File</code></p>
                            </li>
                        }
                    </ul>
                }
            </article>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <article class="status-banner @(_isError ? "error" : "ok")">@_statusMessage</article>
            }
        </div>
    </section>
</div>

@if (_showNewChatConfirm)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseNewChatConfirm"></div>
    <section class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="new-chat-confirm-title">
        <h3 id="new-chat-confirm-title">Start New Chat?</h3>
        <p>Your current conversation will be cleared.</p>
        <div class="confirm-actions">
            <button type="button" @onclick="CloseNewChatConfirm">Cancel</button>
            <button type="button" class="danger" @onclick="ConfirmStartNewChat">Start New Chat</button>
        </div>
    </section>
}

@code {
    private const int HistoryWindowSize = 10;
    private readonly List<ChatMessage> _messages = new();
    private string _query = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _useKnowledgeBase = true;
    private bool _isError;
    private bool _isAsking;
    private bool _isModelsLoading;
    private bool _isIngesting;
    private bool _isCountBusy;
    private bool _isClearBusy;
    private int? _dataCount;
    private IngestResponse? _lastIngest;
    private int _ingestProgressPercent;
    private int _ingestTotalFiles;
    private int _ingestCompletedFiles;
    private int _ingestRemainingFiles;
    private string _ingestCurrentFile = string.Empty;
    private int _ingestFileProgressPercent;
    private int _ingestFileCompletedChunks;
    private int _ingestFileTotalChunks;
    private string _ingestFileStage = "idle";
    private readonly List<IngestUiError> _ingestErrors = new();
    private string? _activeIngestOperationId;
    private List<string> _availableModels = new();
    private string _selectedModel = string.Empty;
    private readonly CancellationTokenSource _lifetimeCts = new();
    private CancellationTokenSource? _askCts;
    private CancellationTokenSource? _ingestCts;
    private bool _showNewChatConfirm;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
        await RefreshCountAsync();
    }

    private async Task HandleAskAsync()
    {
        if (_isAsking || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        var userText = _query.Trim();
        _query = string.Empty;
        _messages.Add(new ChatMessage(true, userText));
        var assistantMessage = new ChatMessage(false, string.Empty)
        {
            SourcePrompt = userText
        };
        _messages.Add(assistantMessage);

        await StreamAssistantResponseAsync(
            userText,
            assistantMessage,
            BuildHistoryPayload());
    }

    private async Task RegenerateAsync(ChatMessage assistantMessage)
    {
        if (_isAsking || assistantMessage.IsUser || string.IsNullOrWhiteSpace(assistantMessage.SourcePrompt))
        {
            return;
        }

        var messageIndex = _messages.IndexOf(assistantMessage);
        if (messageIndex < 0)
        {
            return;
        }

        var history = BuildHistoryPayload(messageIndex);
        assistantMessage.Text = string.Empty;
        assistantMessage.Citations = Array.Empty<Citation>();
        assistantMessage.IsStopped = false;

        await StreamAssistantResponseAsync(assistantMessage.SourcePrompt!, assistantMessage, history);
    }

    private async Task StreamAssistantResponseAsync(string userText, ChatMessage assistantMessage, IReadOnlyList<ChatTurn> history)
    {
        _isAsking = true;
        _isError = false;
        _statusMessage = string.Empty;

        try
        {
            _askCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
            await foreach (var streamEvent in ApiClient.StreamAskAsync(userText, _selectedModel, _useKnowledgeBase, history, _askCts.Token))
            {
                if (string.Equals(streamEvent.EventType, "token", StringComparison.OrdinalIgnoreCase) && streamEvent.Token is not null)
                {
                    assistantMessage.Text += streamEvent.Token.Text;
                }
                else if (string.Equals(streamEvent.EventType, "completed", StringComparison.OrdinalIgnoreCase) && streamEvent.Completed is not null)
                {
                    assistantMessage.Text = streamEvent.Completed.Answer;
                    assistantMessage.Citations = streamEvent.Completed.Citations?.ToArray() ?? Array.Empty<Citation>();
                    assistantMessage.IsStopped = false;
                }
                else if (string.Equals(streamEvent.EventType, "error", StringComparison.OrdinalIgnoreCase) && streamEvent.Error is not null)
                {
                    _isError = true;
                    _statusMessage = streamEvent.Error.Message;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_askCts?.IsCancellationRequested == true)
        {
            if (string.IsNullOrWhiteSpace(assistantMessage.Text))
            {
                assistantMessage.Text = "(stopped)";
            }
            else
            {
                assistantMessage.Text += "\n\n(stopped)";
            }

            assistantMessage.IsStopped = true;
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _askCts?.Dispose();
            _askCts = null;
            _isAsking = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        _isModelsLoading = true;

        try
        {
            var models = await ApiClient.GetModelsAsync(_lifetimeCts.Token);
            _availableModels = models.Models
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Select(m => m.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (_availableModels.Count == 0)
            {
                _isError = true;
                _statusMessage = "No chat models are configured in the API.";
                _selectedModel = string.Empty;
                return;
            }

            var defaultModel = models.DefaultModel?.Trim() ?? string.Empty;
            _selectedModel = _availableModels.FirstOrDefault(m => string.Equals(m, defaultModel, StringComparison.OrdinalIgnoreCase))
                ?? _availableModels[0];
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isModelsLoading = false;
        }
    }

    private async Task RunIngestAsync()
    {
        if (_isIngesting)
        {
            return;
        }

        _isIngesting = true;
        _isError = false;
        _statusMessage = string.Empty;
        _ingestProgressPercent = 0;
        _ingestTotalFiles = 0;
        _ingestCompletedFiles = 0;
        _ingestRemainingFiles = 0;
        _ingestCurrentFile = string.Empty;
        _ingestFileProgressPercent = 0;
        _ingestFileCompletedChunks = 0;
        _ingestFileTotalChunks = 0;
        _ingestFileStage = "idle";

        try
        {
            var start = await ApiClient.StartIngestAsync(_lifetimeCts.Token);
            _activeIngestOperationId = start.OperationId;
            _ingestCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
            await foreach (var progress in ApiClient.StreamIngestAsync(start.OperationId, _ingestCts.Token))
            {
                _ingestProgressPercent = progress.Percent;
                _ingestTotalFiles = progress.TotalFiles;
                _ingestCompletedFiles = progress.CompletedFiles;
                _ingestRemainingFiles = progress.RemainingFiles;
                _ingestCurrentFile = progress.CurrentFile ?? string.Empty;
                if (progress.FileProgress is not null)
                {
                    _ingestFileProgressPercent = progress.FileProgress.Percent;
                    _ingestFileCompletedChunks = progress.FileProgress.CompletedChunks;
                    _ingestFileTotalChunks = progress.FileProgress.TotalChunks;
                    _ingestFileStage = progress.FileProgress.Stage;
                    if (!string.IsNullOrWhiteSpace(progress.FileProgress.File))
                    {
                        _ingestCurrentFile = progress.FileProgress.File;
                    }
                }

                if (string.Equals(progress.Status, "completed", StringComparison.OrdinalIgnoreCase) && progress.Summary is not null)
                {
                    _lastIngest = progress.Summary;
                    _statusMessage = _lastIngest.Message;
                    foreach (var failure in _lastIngest.Failures)
                    {
                        AddIngestError(failure.File, failure.ErrorCode, failure.Message);
                    }
                }

                if (string.Equals(progress.Status, "error", StringComparison.OrdinalIgnoreCase))
                {
                    _isError = true;
                    var errorMessage = progress.ErrorMessage ?? "Ingest failed.";
                    _statusMessage = errorMessage;
                    AddIngestError("(operation)", "ingest_error", errorMessage);
                }
                else if (string.Equals(progress.Status, "canceled", StringComparison.OrdinalIgnoreCase))
                {
                    _statusMessage = "Ingest stopped.";
                }

                await InvokeAsync(StateHasChanged);
            }

            if (_ingestCts?.IsCancellationRequested == true)
            {
                _statusMessage = "Ingest stopped.";
                return;
            }

            await RefreshCountAsync();
        }
        catch (OperationCanceledException) when (_ingestCts?.IsCancellationRequested == true)
        {
            _statusMessage = "Ingest stopped.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
            AddIngestError("(operation)", "client_error", ex.Message);
        }
        finally
        {
            _ingestCts?.Dispose();
            _ingestCts = null;
            _isIngesting = false;
            _activeIngestOperationId = null;
        }
    }

    private async Task RefreshCountAsync()
    {
        if (_isCountBusy)
        {
            return;
        }

        _isCountBusy = true;

        try
        {
            _dataCount = await ApiClient.GetDataCountAsync(_lifetimeCts.Token);
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isCountBusy = false;
        }
    }

    private async Task ClearDataAsync()
    {
        if (_isClearBusy)
        {
            return;
        }

        _isClearBusy = true;
        _isError = false;
        _statusMessage = string.Empty;

        try
        {
            var response = await ApiClient.ClearDataAsync(_lifetimeCts.Token);
            _statusMessage = $"{response.Message} Removed: {response.Removed}";
            _dataCount = 0;
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = ex.Message;
        }
        finally
        {
            _isClearBusy = false;
        }
    }

    public void Dispose()
    {
        _askCts?.Cancel();
        _askCts?.Dispose();
        _ingestCts?.Cancel();
        _ingestCts?.Dispose();
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
    }

    private sealed class ChatMessage
    {
        public ChatMessage(bool isUser, string text, IReadOnlyList<Citation>? citations = null)
        {
            IsUser = isUser;
            Text = text;
            Citations = citations ?? Array.Empty<Citation>();
        }

        public bool IsUser { get; }
        public string Text { get; set; }
        public IReadOnlyList<Citation> Citations { get; set; }
        public bool IsStopped { get; set; }
        public string? SourcePrompt { get; set; }
    }

    private IReadOnlyList<ChatTurn> BuildHistoryPayload(int? uptoExclusive = null)
    {
        var source = uptoExclusive is int count
            ? _messages.Take(count)
            : _messages.AsEnumerable();

        return source
            .TakeLast(HistoryWindowSize)
            .Select(m => new ChatTurn(
                m.IsUser ? "user" : "assistant",
                (m.Text ?? string.Empty).Trim()))
            .Where(turn => !string.IsNullOrWhiteSpace(turn.Content))
            .ToArray();
    }

    private void StopGenerating()
    {
        _askCts?.Cancel();
    }

    private Task StartNewChatAsync()
    {
        _showNewChatConfirm = true;
        return Task.CompletedTask;
    }

    private void CloseNewChatConfirm()
    {
        _showNewChatConfirm = false;
    }

    private void ConfirmStartNewChat()
    {
        _askCts?.Cancel();
        _messages.Clear();
        _query = string.Empty;
        _isError = false;
        _statusMessage = string.Empty;
        _showNewChatConfirm = false;
    }

    private async Task StopIngest()
    {
        _ingestCts?.Cancel();
        _statusMessage = "Stopping ingest...";

        if (!string.IsNullOrWhiteSpace(_activeIngestOperationId))
        {
            try
            {
                await ApiClient.CancelIngestAsync(_activeIngestOperationId, _lifetimeCts.Token);
            }
            catch
            {
                // Fallback to local cancel if API cancel call fails.
            }
        }
    }

    private void ClearIngestErrors()
    {
        _ingestErrors.Clear();
    }

    private void AddIngestError(string file, string errorCode, string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        var normalizedFile = string.IsNullOrWhiteSpace(file) ? "(operation)" : file.Trim();
        var normalizedCode = string.IsNullOrWhiteSpace(errorCode) ? "ingest_error" : errorCode.Trim();
        var normalizedMessage = message.Trim();

        var alreadyExists = _ingestErrors.Any(err =>
            string.Equals(err.File, normalizedFile, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(err.ErrorCode, normalizedCode, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(err.Message, normalizedMessage, StringComparison.Ordinal));
        if (alreadyExists)
        {
            return;
        }

        _ingestErrors.Add(new IngestUiError(normalizedFile, normalizedCode, normalizedMessage));
    }

    private static string GetIngestStageClass(string? stage)
    {
        return stage?.Trim().ToLowerInvariant() switch
        {
            "embedding" => "stage-pill stage-embedding",
            "upserting" => "stage-pill stage-upserting",
            "failed" => "stage-pill stage-failed",
            "completed" => "stage-pill stage-completed",
            "skipped" => "stage-pill stage-skipped",
            _ => "stage-pill"
        };
    }

    private sealed record IngestUiError(string File, string ErrorCode, string Message);
}
