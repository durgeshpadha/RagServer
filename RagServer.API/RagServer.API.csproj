<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RAG-KnowledgeBase\**" />
    <Content Remove="RAG-KnowledgeBase\**" />
    <EmbeddedResource Remove="RAG-KnowledgeBase\**" />
    <None Remove="RAG-KnowledgeBase\**" />

    <Compile Remove="RagServer.Api.Tests\**" />
    <Content Remove="RagServer.Api.Tests\**" />
    <EmbeddedResource Remove="RagServer.Api.Tests\**" />
    <None Remove="RagServer.Api.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Redoc.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

</Project>
